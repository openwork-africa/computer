<?xml version="1.0" encoding="UTF-8"?>
<!-- openbox for the computer: every window fills the 1024x640 screen with no title bar, like a kiosk that is
     still a normal browser. One desktop, no right-click menu to get lost in. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops><number>1</number></desktops>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <placement><policy>Smart</policy></placement>
  <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout></theme>
  <applications>
    <application class="firefox*" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
  <keyboard/>
  <mouse/>
</openbox_config>
